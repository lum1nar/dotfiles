{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "build",
    "instructions": [
        "Always respond in Traditional Chinese (繁體中文)."
    ],
    "permissions": [
        {
            "action": "read",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "think",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "other",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "edit",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*",
            "effect": "ask"
        },
    ],
    "plugins": [
        "git+https://github.com/nagisanzenin/engram.git"
    ],
    "model": "deepseek/deepseek-flash#low",
    "providers": {
        "deepseek": {
            "settings": {
                "apiKey": "{env:DEEPSEEK_API_KEY}",
            },
        },
    },
}
