{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "build",
    "instructions": [
        "Always respond in Traditional Chinese (繁體中文)."
    ],
    "permission": {
        "read": "allow",
        "think": "allow",
        "other": "allow",
        "edit": "ask",
        "bash": "ask",
    },
    "plugin": [
        "git+https://github.com/nagisanzenin/engram.git"
    ],
    "model": "deepseek/deepseek-flash",
    "provider": {
        "deepseek": {
            "options": {
                "apiKey": "{env:DEEPSEEK_API_KEY}",
            },
            "models": {
                "deepseek-v4-flash": {
                    "options": {
                        "reasoningEffort": "low",
                    },
                },
            },
        },
    },
}
